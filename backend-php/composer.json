{
    "name": "uabjb/beca-comedor-backend",
    "description": "Backend API REST orientado a objetos para el Comedor Universitario U.A.B.J.B.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Equipo Beca Comedor UABJB",
            "email": "humberto@uabjb.edu.bo"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BecaComedor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BecaComedor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "start": "php -S 0.0.0.0:8000 -t public"
    }
}
