# Configuración de Firebase (proyecto: beca-comedor-uabjb)
# Copia este archivo a `.env` y completa con los datos de tu proyecto
# (Console Firebase ➜ Configuración del proyecto ➜ Tus apps ➜ Web).
#
# Copia estos valores generados "sin llaves" en firebase.js (sección config):

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=beca-comedor-uabjb
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL del Cloudflare Worker (Telegram + validación). Se define tras `wrangler deploy`.
VITE_WORKER_URL=http://localhost:8787